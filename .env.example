NODE_ENV=development
POSTGRES_DB=cloudpilot
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=replace-with-a-local-password
WEB_PORT=5173
API_PORT=3000
API_HOST=127.0.0.1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cloudpilot
PGUSER=cloudpilot
PGPASSWORD=replace-with-a-local-password
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=604800
SESSION_IDLE_SECONDS=86400
SESSION_COOKIE_NAME=cloudpilot_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
CSRF_SECRET=replace-with-a-random-development-secret-at-least-32-characters
PASSWORD_BCRYPT_ROUNDS=12
VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
EMAIL_DELIVERY_MODE=capture
