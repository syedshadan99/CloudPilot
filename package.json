{
  "name": "cloudpilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:status": "node scripts/database.mjs status",
    "db:seed": "node scripts/database.mjs seed",
    "db:reset": "node scripts/database.mjs reset",
    "test:database": "node --test apps/api/test/integration/database.test.mjs apps/api/test/integration/identity-password.test.mjs",
    "test:unit": "npm run build --workspace @cloudpilot/api && node --test apps/api/test/unit/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.0"
  }
}
